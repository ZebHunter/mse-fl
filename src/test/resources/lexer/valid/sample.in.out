LET 'let' @ 1:0
IDENTIFIER 'x' @ 1:4
COLON ':' @ 1:5
TYPE_INT 'Int' @ 1:7
ASSIGN '=' @ 1:11
INT_LITERAL '10' @ 1:13
SEMI ';' @ 1:15
IF 'if' @ 2:0
LPAREN '(' @ 2:3
IDENTIFIER 'x' @ 2:4
GT '>' @ 2:6
INT_LITERAL '0' @ 2:8
RPAREN ')' @ 2:9
LBRACE '{' @ 2:11
IDENTIFIER 'x' @ 3:4
ASSIGN '=' @ 3:6
IDENTIFIER 'x' @ 3:8
MINUS '-' @ 3:10
INT_LITERAL '1' @ 3:12
SEMI ';' @ 3:13
RBRACE '}' @ 4:0
